#!/usr/bin/env bash
# project.sh — one tmux session per project → dev | nvim | assistant

choose_project() {
  if [[ $# -eq 1 ]]; then
    # If argument is provided, expand to absolute path and remove trailing slash
    local path="$(realpath "$1" 2>/dev/null || echo "$1")"
    echo "${path%/}"
  else
    # Otherwise, show fzf picker for ~/code directories
    find ~/code -mindepth 1 -maxdepth 1 -type d | fzf
  fi
}
sanitize()       { basename "$1" | tr '. ' '-' ; }

make_windows() {
  local s="$1" dir="$2"
  local cwd="$dir"

  # Use dev subdirectory as CWD if it exists
  [[ -d "$dir/dev" ]] && cwd="$dir/dev"

  tmux new-session -d -s "$s" -c "$cwd" -n dev          # dev
  tmux new-window  -t "$s:" -c "$cwd" -n nvim          # nvim
  tmux send-keys   -t "$s:nvim"       'nvim .' C-m
  tmux new-window  -t "$s:" -c "$cwd" -n assistant      # assistant
  tmux send-keys   -t "$s:assistant"  'export AWS_PROFILE=statmuse && opencode' C-m
  tmux select-window -t "$s:dev"                        # dev is active
}

main() {
  local dir sess
  dir="$(choose_project "$@")" || exit 0
  [[ -z $dir ]] && exit 0

  # If a path was passed as argument, use the path as session name
  # Strip common prefix and sanitize
  if [[ $# -eq 1 ]]; then
    # Remove /Users/adam/code prefix if present
    local relative_path="${dir#/Users/adam/code/}"
    # Remove trailing slash if present
    relative_path="${relative_path%/}"
    # Convert path separators to dashes and remove any trailing dashes
    sess="$(echo "$relative_path" | tr '/.[:space:]' '-' | sed 's/-*$//')"
  else
    sess="$(sanitize "$dir")"
  fi

  # Check for an EXACT session name match
  # List sessions (tmux ls), extract names (cut), check for exact match (grep)
  if tmux list-sessions -F '#{session_name}' 2>/dev/null | grep -q "^${sess}$"; then
    # Session exists, attach or switch
    [[ -z $TMUX ]] && tmux attach-session -t "$sess" || tmux switch-client -t "$sess"
    exit 0
  fi

  # Session does not exist, create it
  make_windows "$sess" "$dir"
  [[ -f "$dir/.tmux" ]] && tmux source-file "$dir/.tmux" # Apply project-specific config if it exists

  # Attach or switch to the newly created session
  [[ -z $TMUX ]] && tmux attach-session -t "$sess" || tmux switch-client -t "$sess"
}

main "$@"
